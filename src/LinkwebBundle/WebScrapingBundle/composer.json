{
    "name": "linkweb/shared-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "description": "Acme bundle description",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "../../vendor/symfony/framework-bundle": "^v7.2",
        "../../vendor/symfony/orm-pack": "^2.4",
        "../../vendor/doctrine/orm": "^3.0",
        "../../vendor/doctrine/migrations": "^3.8"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Linkweb\\SharedBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Linkweb\\SharedBundle\\Tests\\": "tests/"
        }
    }
}
